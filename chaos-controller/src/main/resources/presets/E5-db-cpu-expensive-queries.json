{
  "name": "DB CPU: maliyetli raporlar (FlightOps)",
  "scenario": "E5-db-cpu-expensive-queries",
  "warmupSec": 30,
  "baselineSec": 120,
  "loadSec": 180,
  "recoverySec": 120,
  "background": {
    "enabled": true,
    "rpsPerApp": 1.0,
    "apps": null
  },
  "targets": [
    {
      "app": "flightops",
      "role": "stress",
      "mode": "CONCURRENCY",
      "rps": 0,
      "concurrency": 6,
      "rampUpSec": 20,
      "maxInFlight": 64,
      "timeoutMs": 20000,
      "mix": {
        "load_factor_report": 100
      },
      "dataSize": 30,
      "readWriteRatio": null,
      "hotRow": false,
      "holdMs": 0,
      "activePhases": "LOAD"
    }
  ]
}