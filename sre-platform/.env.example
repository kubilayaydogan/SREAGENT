# SRE Operations Platform — ortam değişkenleri (örnek). GERÇEK DEĞER YAZMAYIN.
# APP_VM'de: scripts/gen-sre-platform-env.sh deploy/out/sre-platform.env → app-vm/sre-platform.env (chmod 600).
# Dynatrace / Claude değişkenleri ayrı dosyada: app-vm/agent.env (scripts/gen-agent-env.sh).

# --- gizli (yalnız sre-platform.env)
POSTGRES_PASSWORD=            # sre-postgres container'ı (ilk açılışta volume'a işlenir)
SRE_DB_PASSWORD=              # backend/worker bağlantısı — POSTGRES_PASSWORD ile aynı
SRE_JWT_SECRET=               # ≥32 karakter rastgele
SRE_ADMIN_USERNAME=admin
SRE_ADMIN_PASSWORD=           # yalnız hiç admin yoksa ilk açılışta kullanılır

# --- bağlantı (varsayılanlar compose ağına göre)
# SRE_DATABASE_URL=           # verilirse SRE_DB_* yerine kullanılır (postgresql+psycopg://...)
SRE_DB_HOST=sre-postgres
SRE_DB_PORT=5432
SRE_DB_NAME=sre
SRE_DB_USER=sre
SRE_DB_POOL_SIZE=5
SRE_DB_MAX_OVERFLOW=5
SRE_DB_POOL_TIMEOUT_S=10
SRE_DB_STATEMENT_TIMEOUT_MS=30000

# --- API / oturum
SRE_JWT_TTL_MINUTES=480
SRE_CORS_ORIGINS=             # arayüz aynı origin'den (nginx /api) sunulduğunda boş bırakın
SRE_LOG_LEVEL=INFO
SRE_ENVIRONMENT=lab

# --- ajan çalıştırma sınırları
SRE_MAX_CONCURRENT_INVESTIGATIONS=2
SRE_INVESTIGATION_TIMEOUT_S=240
SRE_CHAT_HISTORY_MESSAGES=12

# --- worker
SRE_WORKER_ID=sre-worker-1
SRE_WATCH_ENABLED=true        # eski sre-agent watch'unun yerine (aynı anda ikisini çalıştırmayın)
SRE_HEALTH_CHECK_MINUTES=15   # 0 = kapalı
SRE_HEALTH_CHECK_WINDOW_MINUTES=15
# periyodik kontrolde de RCA Claude ile yazılır (15 dk aralıkla yaklaşık 96 çağrı/gün)
SRE_HEALTH_CHECK_LLM=true
SRE_RETENTION_DAYS=180        # incident/RCA/geri bildirim/sohbete bağlı araştırmalar silinmez

# --- Slack bildirimi (yüksek riskli RCA). Webhook boşsa bildirim kapalı. Webhook adresi secret'tır; repo'ya yazmayın.
# Slack: api.slack.com/apps → Create App → Incoming Webhooks → Add New Webhook → kanal/DM seç → URL'yi buraya.
SRE_SLACK_WEBHOOK_URL=
# risk_score bu değere eşit veya üstündeyse (COMPLETED/PARTIAL) mesaj gönderilir; 75 = "kritik" band başlangıcı
SRE_SLACK_RISK_THRESHOLD=75
# mesajdaki "Araştırmayı aç" linkinin kökü
SRE_PUBLIC_URL=http://172.20.229.26:8090

# --- compose
SRE_UI_PORT=8090
SRE_IMAGE_TAG=0.1.0

# LLM Monitoring: worker LangSmith trace/LLM özetlerini sre.llm_runs'a senkronlar (dakika; 0 = kapalı)
SRE_LANGSMITH_SYNC_MINUTES=5
# İlk senkronda geriye dönük gün (LangSmith standart trace'leri ~14 gün tutar)
SRE_LANGSMITH_BACKFILL_DAYS=7
