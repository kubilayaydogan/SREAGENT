# APP_VM ortam değişkenleri. Kopyala: cp .env.example .env && chmod 600 .env
# Gerçek parola/token'ları yalnız .env içine yaz; repoya ekleme (.gitignore'da).

# ---- DB_VM bağlantısı ----
DB_HOST=192.0.2.20
DB_PORT=5432
DB_NAME=airlab
DB_HOST_LABEL=db-vm

# Servis başına ayrı DB rolü (db-vm/db-vm.env ile AYNI değerler)
RESERVATION_DB_PASSWORD=change-me-res
CHECKIN_DB_PASSWORD=change-me-chk
FLIGHTOPS_DB_PASSWORD=change-me-ops
BAGGAGE_DB_PASSWORD=change-me-bag
OWNER_DB_PASSWORD=change-me-owner
MONITOR_DB_PASSWORD=change-me-mon
DYNATRACE_DB_PASSWORD=change-me-dt

# ---- Uygulamalar ----
# Portları yalnız APP_VM iç IP'sine bağla (0.0.0.0 yerine)
APP_BIND_IP=192.0.2.10
SPRING_PROFILES_ACTIVE=lab
LOG_FORMAT=ecs
HIKARI_MAX_POOL=8
HIKARI_MIN_IDLE=2
HIKARI_CONNECTION_TIMEOUT_MS=2000
TOMCAT_MAX_THREADS=50
APP_MEM_LIMIT=640m
APP_CPUS=1.0

# ---- Lab senaryo uçları (en az 16 karakter, rastgele üret: openssl rand -hex 24) ----
LAB_TOKEN=replace-with-random-hex-48
LAB_ALLOWED_CIDRS=172.28.0.0/24,127.0.0.1/32
LAB_MAX_HOLD_MS=5000
LAB_PRESSURE_POOL_MAX=22

# ---- chaos-controller ----
CHAOS_USER=chaos
CHAOS_PASSWORD=replace-with-strong-password
CHAOS_MEM_LIMIT=512m
CHAOS_CPUS=1.0

# ---- Migration (yalnız tools profili) ----
LAB_ALLOW_RESET=false

# ---- pg-lock-collector → Dynatrace (SaaS) ----
# dryrun: yalnız /data/collector.jsonl ; dynatrace: Metrics/Logs API v2 ; both
COLLECTOR_DT_MODE=dryrun
COLLECTOR_INTERVAL_S=5
COLLECTOR_STATEMENTS_INTERVAL_S=60
# https://<environment-id>.live.dynatrace.com   (secret içermez)
DT_URL=
# Api-Token, kapsamlar: metrics.ingest, logs.ingest
DT_INGEST_TOKEN=

IMAGE_TAG=1.0.0
