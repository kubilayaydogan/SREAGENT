# DB_VM kurulum değişkenleri. Kopyala: cp db-vm.env.example db-vm.env && chmod 600 db-vm.env
# Gerçek parolaları yalnız db-vm.env içine yaz; repoya ekleme.

APP_VM_IP=192.0.2.10            # APP_VM (docker host) IP'si — yalnız buna 5432 açılır
DB_LISTEN_ADDR=192.0.2.20       # DB_VM'in iç ağ IP'si (0.0.0.0 KULLANMA)
DB_PORT=5432
DB_NAME=airlab

PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB

OWNER_PW=change-me-owner
RESERVATION_PW=change-me-res
CHECKIN_PW=change-me-chk
FLIGHTOPS_PW=change-me-ops
BAGGAGE_PW=change-me-bag
MONITOR_PW=change-me-mon
DYNATRACE_PW=change-me-dt

# ActiveGate APP_VM dışında ise IP'sini yaz (PostgreSQL extension uzaktan bağlanır)
ACTIVEGATE_IP=
